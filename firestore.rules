rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isClinicMember(clinicId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    function isClinicAdmin(clinicId) {
      return isClinicMember(clinicId) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /clinics/{clinicId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isClinicMember(clinicId);

      match /members/{uid} {
        allow create: if isSignedIn() && (request.auth.uid == uid || isClinicAdmin(clinicId));
        allow update, delete: if isClinicMember(clinicId) &&
          (request.auth.uid == uid || isClinicAdmin(clinicId));
        allow read: if request.auth.uid == uid || isClinicMember(clinicId);
      }

      match /settings/{document=**} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /staff/{document=**} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /patients/{patientId} {
        allow read, write: if isClinicMember(clinicId);

        match /treatments/{document=**} {
          allow read, write: if isClinicMember(clinicId);
        }

        match /medical_images/{document=**} {
          allow read, write: if isClinicMember(clinicId);
        }
      }

      match /appointments/{appointmentId} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /treatment_master/{document=**} {
        allow read, write: if isClinicMember(clinicId);
      }

      match /prefix_master/{document=**} {
        allow read, write: if isClinicMember(clinicId);
      }
    }

    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /settings/{document=**} {
      allow read, write: if false;
    }

    match /treatment_master/{document=**} {
      allow read, write: if false;
    }

    match /prefix_master/{document=**} {
      allow read, write: if false;
    }

    match /patients/{document=**} {
      allow read, write: if false;
    }

    match /appointments/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
