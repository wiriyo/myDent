rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasClinicClaim(clinicId) {
      return request.auth != null && clinicId != null && clinicId != '' &&
        request.auth.token.clinicId == clinicId;
    }

    function isLegacyPatientAccessible(patientId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/patients/$(patientId)) &&
        firestore.get(/databases/(default)/documents/patients/$(patientId)).data.clinicId == request.auth.token.clinicId;
    }

    match /clinic_logos/{clinicId}/{allPaths=**} {
      allow read, write: if hasClinicClaim(clinicId);
    }

    match /medical_images/{clinicId}/{patientId}/{allPaths=**} {
      allow read, write: if hasClinicClaim(clinicId);
    }

    match /medical_images/{patientId}/{allPaths=**} {
      allow read, write: if isLegacyPatientAccessible(patientId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
