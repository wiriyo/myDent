rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isClinicMember(clinicId) {
      return isSignedIn() &&
        clinicId != null && clinicId != '' &&
        firestore.exists(/databases/(default)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    function isMemberForLegacyPatient(patientId) {
      return firestore.exists(/databases/(default)/documents/patients/$(patientId)) &&
        isClinicMember(firestore.get(/databases/(default)/documents/patients/$(patientId)).data.clinicId);
    }

    match /clinic_logos/{clinicId}/{allPaths=**} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /medical_images/{clinicId}/{patientId}/{allPaths=**} {
      allow read, write: if isClinicMember(clinicId);
    }

    match /medical_images/{patientId}/{allPaths=**} {
      allow read, write: if isSignedIn() && isMemberForLegacyPatient(patientId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
